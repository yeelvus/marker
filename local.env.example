# 复制为 local.env 后按需修改（local.env 不会提交到 git）
#   cp local.env.example local.env
#
# process_docs.py / GUI 会自动读取本文件。

# =============================================================================
# 一、最大化本机算力（M1/M2/M3 + llama.cpp）
# 说明：无法把 CPU/GPU「超频」，只能把已有 Metal GPU / CPU 用满且避免 Swap。
# 你的机器约 16GB 统一内存：并发宁小勿大；内存不够时变慢比变快更常见。
# =============================================================================

# 推理后端：Apple Silicon 用 llamacpp（走 Metal GPU）
SURYA_INFERENCE_BACKEND=llamacpp

# 小模型（版面错误检测等）走 MPS
TORCH_DEVICE=mps
PYTORCH_ENABLE_MPS_FALLBACK=1

# GGUF 尽量全部上 GPU（99 = 能放的层全放）
LLAMA_CPP_NGL=99

# 保持推理服务常驻，避免每次转换重新加载大模型（强烈建议）
SURYA_INFERENCE_KEEP_ALIVE=1

# VLM 并发请求数（16GB 建议 2；32GB 可试 4；过大易 Swap 变慢）
SURYA_INFERENCE_PARALLEL=2

# 每个并发槽的上下文长度（内存紧可保持 8192）
SURYA_INFERENCE_CTX_PER_SLOT=8192

# llama-server 额外参数：CPU 线程 + Flash Attention + 提高优先级
# M1 Pro 8 核示例：
LLAMA_CPP_EXTRA_ARGS=--threads 8 --threads-batch 8 --flash-attn on --prio 2

# CPU 侧 OpenMP（给 torch 等；不宜再开太大，会和 GPU 路径抢资源）
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
VECLIB_MAXIMUM_THREADS=4
TOKENIZERS_PARALLELISM=false

# =============================================================================
# 二、系统层（比改代码更重要，需你在 macOS 里做）
# =============================================================================
# 1. 接电源，关闭「低电量模式」：系统设置 → 电池 → 低电量模式 = 关
# 2. 转换时关掉 Chrome 多标签、其它大模型/视频，腾出统一内存（最关键）
# 3. 活动监视器里看「内存压力」：黄色/红色时先关软件，不要盲目加 PARALLEL
# 4. 外接硬盘上的 PDF 会慢：尽量放到内置 SSD
# 5. 需要 OCR 时第一次会下模型，保持网络畅通

# =============================================================================
# 三、算法路径选择（对速度影响往往比「调线程」更大）
# =============================================================================
# 电子 PDF（可选中复制文字）：加 --disable_ocr 或 GUI 勾选「禁用 OCR」→ 可快数倍
# 扫描件：必须 OCR，用 --mode fast（不要 balanced，Mac 更慢）
# 最快预设：--preset speed
# 多文件批量：--workers 1（开 OCR 时）；纯文本可 --workers 2

# =============================================================================
# 四、LLM API（可选，与本机算力无关）
# =============================================================================
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
